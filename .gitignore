# ── Python ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# ── Secrets (Telegram bot token) — NEVER push ───────────────────────────
telegram_secrets.py

# ── Local Claude config and skills: authoring aids, not project code ───
.claude/

# ── Unit tests: kept locally, not published ───────────────────────
tests/

# ── Training run outputs ─────────────────────────────────────
# The whole tree stays local. The checkpoints behind the reported numbers are
# published under checkpoints/ instead, which is why *.npz is re-included there.
results/
*.npz
!checkpoints/**/*.npz

# ── Telegram training monitor: operational, not part of the method ─────
comms/

# ── LaTeX build intermediates (keep .tex/.bib/.pdf/images) ──────────────
*.aux
*.bbl
*.blg
*.out
*.toc
*.synctex.gz
*.fls
*.fdb_latexmk

# ── Logs / OS cruft ─────────────────────────────────────────────────────
*.log
.DS_Store
Thumbs.db
params_*_backup.py

# ── Third-party papers: copyrighted, kept locally for reference only ────
# The repo is public; redistributing publisher PDFs is not ours to do.
Previous Paper/

# ────────── Paper working tree: only the submitted PDF is published ──────────
# Sources, figures, the bibliography, the build script, the review notes and
# the LaTeX scratch dirs all stay local.
Research Paper/*
!Research Paper/manuscript.pdf
*.tex.bak*

# ── Transient launcher state (superseded by the .meta provenance logs) ──
analysis/data/*.heartbeat
analysis/data/*.gpu-aborted

# ── Windows "2>nul" artifact ────────────────────────────────────────────
nul
