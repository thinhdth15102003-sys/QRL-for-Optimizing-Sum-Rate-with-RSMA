# ── Python ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# ── Secrets (Telegram bot token) — NEVER push ───────────────────────────
telegram_secrets.py

# ── Local Claude config (KEEP .claude/skills/, drop local settings/state) ─
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/*.lock

# ── Training run outputs (large / reproducible artifacts) ───────────────
# Keeps results/oracle_sweep_*.txt/.csv + results/probe_*.txt/.json (evidence).
results/result_*/
results/Training-Case 1/
results/claude_inbox.jsonl
*.npz

# ── LaTeX build intermediates (keep .tex/.bib/.pdf/images) ──────────────
*.aux
*.bbl
*.blg
*.out
*.toc
*.synctex.gz
*.fls
*.fdb_latexmk

# ── Logs / OS cruft ─────────────────────────────────────────────────────
*.log
.DS_Store
Thumbs.db
results/Training-Case 2/
params_*_backup.py
results/phase_b_feasibility_*.txt

# ── Third-party papers: copyrighted, kept locally for reference only ────
# The repo is public; redistributing publisher PDFs is not ours to do.
Previous Paper/

# ── LaTeX scratch build dirs + editor backups ───────────────────────────
Research Paper/.ob_*/
Research Paper/.build_*/
*.tex.bak*

# ── Transient launcher state (superseded by the .meta provenance logs) ──
analysis/data/*.heartbeat
analysis/data/*.gpu-aborted

# ── Windows "2>nul" artifact ────────────────────────────────────────────
nul
